import NativeActionDirectionalDifferential
import Mathlib.Analysis.Calculus.Deriv.Slope

/-! Original action protocols are actual locally admitted LF curves, with a
topological first-order tangent. Their outputs are action derivatives. A
Hadamard limit condition is explicit analytic regularity; no Ward identity,
stress tensor or field equation is a field of the protocol. -/
namespace AASCSemanticExhaustion
noncomputable section
set_option autoImplicit false
open Filter TopologicalSpace
open scoped Topology

variable {P : Type*} [AddCommGroup P] [Module ℝ P] [TopologicalSpace P]
  [IsTopologicalAddGroup P] [ContinuousSMul ℝ P]

structure NativeActionCurve (P : Type*) [AddCommGroup P] [Module ℝ P]
    [TopologicalSpace P] where
  curve : ℝ → P
  base : curve 0=0
  continuousAt : ContinuousAt curve 0
  tangent : P
  tangent_limit : Tendsto (fun t : ℝ => t⁻¹ • curve t) (𝓝[≠] 0) (𝓝 tangent)

def nativeStraightActionCurve (h : P) : NativeActionCurve P where
  curve t := t • h
  base := zero_smul ℝ h
  continuousAt := (continuous_id.smul continuous_const).continuousAt
  tangent := h
  tangent_limit := by
    have heq : (fun t : ℝ => t⁻¹ • (t • h)) =ᶠ[𝓝[≠] 0] fun _ => h := by
      filter_upwards [self_mem_nhdsWithin] with t ht
      have hn : t≠0 := ht
      simp [smul_smul,hn]
    exact tendsto_const_nhds.congr' heq.symm

def NativeActionHadamardAtZero (S : P → ℝ) : Prop :=
  ∀ (v : ℝ → P) (h : P), Tendsto v (𝓝[≠] 0) (𝓝 h) →
    Tendsto (fun t : ℝ => t⁻¹ * (S (t • v t)-S 0)) (𝓝[≠] 0)
      (𝓝 (nativeActionDirectional S h))

theorem native_action_curve_locally_admitted (U : Opens P) (base : (0:P)∈U)
    (π : NativeActionCurve P) : ∀ᶠ t in 𝓝 0, π.curve t∈U := by
  apply π.continuousAt.eventually
  rw [π.base]
  exact U.isOpen.mem_nhds base

theorem native_action_hadamard_curve_derivative (S : P → ℝ)
    (regular : NativeActionHadamardAtZero S) (π : NativeActionCurve P) :
    HasDerivAt (fun t => S (π.curve t)) (nativeActionDirectional S π.tangent) 0 := by
  have hd := regular (fun t => t⁻¹ • π.curve t) π.tangent π.tangent_limit
  apply hasDerivAt_iff_tendsto_slope_zero.mpr
  have heq : (fun t : ℝ => t⁻¹ * (S (t • (t⁻¹ • π.curve t))-S 0))
      =ᶠ[𝓝[≠] 0] (fun t : ℝ => t⁻¹ • (S (π.curve (0+t))-S (π.curve 0))) := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    have hn : t≠0 := ht
    simp [smul_smul,hn,π.base,smul_eq_mul]
  exact hd.congr' heq

theorem native_action_curve_output_receipt (S : P → ℝ)
    (regular : NativeActionHadamardAtZero S) (π : NativeActionCurve P) :
    deriv (fun t => S (π.curve t)) 0 = nativeActionDirectional S π.tangent :=
  (native_action_hadamard_curve_derivative S regular π).deriv

variable {Ω : Opens (Fin 4 → ℝ)}

/-- The incidence is generated by the actual curve tangent; every original
curve protocol occurs. Full-probe totality is proved by the canonical actual
straight deformation curves, not stored as an input certificate. -/
def nativeActionOperationalIncidence (S : MetricSourceProbe Ω → ℝ)
    (finiteRegular : NativeActionFiniteParamDifferentiable S)
    (hadamard : NativeActionHadamardAtZero S) :
    OperationalMetricIncidence Ω (NativeActionCurve (MetricSourceProbe Ω)) where
  incident h π := π.tangent=h
  output π := deriv (fun t => S (π.curve t)) 0
  total h := ⟨nativeStraightActionCurve h,rfl⟩
  coherent h π ρ hπ hρ := by
    rw [native_action_curve_output_receipt S hadamard,
      native_action_curve_output_receipt S hadamard,hπ,hρ]
  add_compatible h k π ρ hπ hρ := by
    refine ⟨nativeStraightActionCurve (h+k),rfl,?_⟩
    rw [native_action_curve_output_receipt S hadamard,
      native_action_curve_output_receipt S hadamard,
      native_action_curve_output_receipt S hadamard]
    exact (native_action_directional_add S finiteRegular h k).trans (by rw [hπ,hρ])
  smul_compatible a h π hπ := by
    refine ⟨nativeStraightActionCurve (a • h),rfl,?_⟩
    rw [native_action_curve_output_receipt S hadamard,
      native_action_curve_output_receipt S hadamard]
    simpa only [hπ,smul_eq_mul] using native_action_directional_smul S finiteRegular a h

theorem native_action_operational_response_is_directional (S : MetricSourceProbe Ω → ℝ)
    (finiteRegular : NativeActionFiniteParamDifferentiable S)
    (hadamard : NativeActionHadamardAtZero S) (h : MetricSourceProbe Ω) :
    operationalMetricResponse (nativeActionOperationalIncidence S finiteRegular hadamard) h =
      nativeActionDirectional S h := by
  rw [operational_response_of_incident _ h (nativeStraightActionCurve h) rfl]
  exact native_action_curve_output_receipt S hadamard _

theorem native_action_protocol_completeness (S : MetricSourceProbe Ω → ℝ)
    (finiteRegular : NativeActionFiniteParamDifferentiable S)
    (hadamard : NativeActionHadamardAtZero S)
    (π : NativeActionCurve (MetricSourceProbe Ω)) :
    (nativeActionOperationalIncidence S finiteRegular hadamard).incident π.tangent π := rfl

#print axioms nativeStraightActionCurve
#print axioms native_action_curve_locally_admitted
#print axioms native_action_hadamard_curve_derivative
#print axioms native_action_curve_output_receipt
#print axioms nativeActionOperationalIncidence
#print axioms native_action_operational_response_is_directional
#print axioms native_action_protocol_completeness
end
end AASCSemanticExhaustion
