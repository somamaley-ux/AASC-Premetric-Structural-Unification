import KGFockCoreSpatialCharges
import KGPreHilbertProbability
import Mathlib.Analysis.InnerProductSpace.TensorProduct

/-! Independent comparison objects generated by the actual KG common core.
The tensor carriers are algebraic inner-product spaces, with all finite sums
of tensors, not an asserted identification with the one-object Fock core. -/
noncomputable section
namespace AASCKleinGordon
open scoped TensorProduct
open KGQuantum

inductive KGComparisonObject where
  | unit
  | kg
  | tensor (A B : KGComparisonObject)

structure KGInnerCarrier where
  carrier : Type
  normed : NormedAddCommGroup carrier
  innerSpace : @InnerProductSpace ℂ carrier _ normed.toSeminormedAddCommGroup

attribute [local instance] KGInnerCarrier.normed KGInnerCarrier.innerSpace
instance : CoeSort KGInnerCarrier Type := ⟨KGInnerCarrier.carrier⟩

def kgInnerCarrierOf (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℂ E] :
    KGInnerCarrier := ⟨E,inferInstance,inferInstance⟩

def kgComparisonSpace (a : Parameters) : KGComparisonObject → KGInnerCarrier
  | .unit => kgInnerCarrierOf ℂ
  | .kg => kgInnerCarrierOf (fockCoreDomain a)
  | .tensor A B => kgInnerCarrierOf (kgComparisonSpace a A ⊗[ℂ] kgComparisonSpace a B)

abbrev KGComparisonCarrier (a : Parameters) (A : KGComparisonObject) := kgComparisonSpace a A

theorem kg_raw_comparison_nonempty (a : Parameters) (A : KGComparisonObject) :
    Nonempty (PureVector (KGComparisonCarrier a A)) := by
  induction A with
  | unit => exact ⟨(⟨1,one_ne_zero⟩ : PureVector ℂ)⟩
  | kg =>
    change Nonempty (PureVector (fockCoreDomain a))
    exact ⟨⟨fockCoreDomainEquiv a vacuumCore,by
      intro h
      apply vacuumCore_nonzero
      apply (fockCoreDomainEquiv a).injective
      simpa only [map_zero] using h⟩⟩
  | tensor A B hA hB =>
    change Nonempty (PureVector (KGComparisonCarrier a A ⊗[ℂ] KGComparisonCarrier a B))
    obtain ⟨x⟩ := hA
    obtain ⟨y⟩ := hB
    exact ⟨⟨x.val ⊗ₜ[ℂ] y.val,by
      apply norm_ne_zero_iff.mp
      rw [TensorProduct.norm_tmul]
      exact mul_ne_zero (norm_ne_zero_iff.mpr x.property)
        (norm_ne_zero_iff.mpr y.property)⟩⟩


end AASCKleinGordon
