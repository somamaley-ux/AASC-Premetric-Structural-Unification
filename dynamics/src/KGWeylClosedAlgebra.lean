import KGWeylStarAlgebra
import Mathlib.Topology.Algebra.StarSubalgebra

noncomputable section
set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 200000
namespace AASCKleinGordon

/-- The operator-norm closed star algebra generated by the actual bounded Weyl
displacements. The ambient norm and adjoint are the original Hilbert operator ones. -/
def globalWeylClosedAlgebra (a : Parameters) :
    StarSubalgebra ℂ (FockHilbert a →L[ℂ] FockHilbert a) :=
  (globalWeylStarAlgebra a).topologicalClosure

theorem globalWeylAlgebra_le_closed (a : Parameters) :
    globalWeylAlgebra a≤(globalWeylClosedAlgebra a).toSubalgebra :=
  (globalWeylStarAlgebra a).le_topologicalClosure

theorem globalWeylClosedAlgebra_isClosed (a : Parameters) :
    IsClosed (globalWeylClosedAlgebra a : Set (FockHilbert a →L[ℂ] FockHilbert a)) :=
  (globalWeylStarAlgebra a).isClosed_topologicalClosure

instance globalWeylClosedAlgebra_complete (a : Parameters) :
    CompleteSpace (globalWeylClosedAlgebra a) :=
  (globalWeylClosedAlgebra_isClosed a).completeSpace_coe

theorem globalWeylClosedAlgebra_irreducible (a : Parameters) :
    GlobalCharge.ObservableIrreducible (globalWeylClosedAlgebra a).toSubalgebra := by
  intro W hc hi
  apply globalWeylAlgebra_irreducible a W hc
  intro T v hv
  exact hi ⟨T.val,globalWeylAlgebra_le_closed a T.property⟩ v hv

theorem globalWeylClosedAlgebra_vacuum_cyclic (a : Parameters) :
    (GlobalCharge.vacuumOrbitSpan (globalWeylClosedAlgebra a).toSubalgebra
      (fockVacuum a)).topologicalClosure=⊤ := by
  exact GlobalCharge.irreducible_nonzero_vacuum_is_cyclic
    (globalWeylClosedAlgebra a).toSubalgebra (globalWeylClosedAlgebra_irreducible a)
    (fockVacuum a) (by
      rw [← exponentialVector_zero]
      exact exponentialVector_ne_zero a 0)

end AASCKleinGordon
