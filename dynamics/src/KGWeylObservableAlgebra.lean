import KGWeylCommutant
import ObservableVacuumUniqueness

noncomputable section
set_option maxHeartbeats 2600000
set_option synthInstance.maxHeartbeats 200000
open scoped SchwartzMap
namespace AASCKleinGordon

/-- The concrete algebra generated by all bounded displacements whose labels
are original complex momentum Schwartz functions. -/
def globalWeylAlgebra (a : Parameters) : Subalgebra ℂ (FockHilbert a →L[ℂ] FockHilbert a) :=
  Algebra.adjoin ℂ (Set.range (weylOperator a))

theorem weylOperator_mem_globalWeylAlgebra (a : Parameters) (g : 𝓢(Momentum,ℂ)) :
    weylOperator a g∈globalWeylAlgebra a :=
  Algebra.subset_adjoin ⟨g,rfl⟩

theorem closed_weyl_invariant_projection_commutes (a : Parameters)
    (W : Submodule ℂ (FockHilbert a)) [CompleteSpace W]
    (hW : ∀ (g : 𝓢(Momentum,ℂ)) (v : FockHilbert a),v∈W → weylOperator a g v∈W) :
    CommutesWithWeyl a W.starProjection := by
  intro g
  let U:=weylUnitary a g
  have hm : W.map (U.toLinearEquiv : FockHilbert a →ₗ[ℂ] FockHilbert a)=W := by
    ext v
    constructor
    · rintro ⟨x,hx,rfl⟩
      exact hW g x hx
    · intro hv
      refine ⟨weylOperator a (-g) v,hW (-g) v hv,?_⟩
      exact congrArg (fun A : FockHilbert a →L[ℂ] FockHilbert a => A v)
        (weylOperator_mul_inverse a g)
  apply ContinuousLinearMap.ext
  intro v
  have hp:=Submodule.starProjection_map_apply U W (U v)
  simpa only [hm,U.symm_apply_apply] using hp

/-- Observable irreducibility of the actual bounded global Weyl algebra on the
same original Fock carrier. Poincaré irreducibility is neither used nor asserted. -/
theorem globalWeylAlgebra_irreducible (a : Parameters) :
    GlobalCharge.ObservableIrreducible (globalWeylAlgebra a) := by
  intro W hclosed hinv
  letI : CompleteSpace W:=hclosed.completeSpace_coe
  have hw : ∀ (g : 𝓢(Momentum,ℂ)) (v : FockHilbert a),v∈W → weylOperator a g v∈W := by
    intro g v hv
    exact hinv ⟨weylOperator a g,weylOperator_mem_globalWeylAlgebra a g⟩ v hv
  have hp:=weyl_commutant_is_scalar a W.starProjection
    (closed_weyl_invariant_projection_commutes a W hw)
  by_cases hz : W=⊥
  · exact Or.inl hz
  · right
    obtain ⟨v,hv,hv0⟩:=Submodule.exists_mem_ne_zero_of_ne_bot hz
    have he:=congrArg (fun A : FockHilbert a →L[ℂ] FockHilbert a => A v) hp
    change W.starProjection v=inner ℂ (fockVacuum a) (W.starProjection (fockVacuum a)) • v at he
    rw [W.starProjection_eq_self_iff.mpr hv] at he
    have hl : inner ℂ (fockVacuum a) (W.starProjection (fockVacuum a))=1 := by
      apply (smul_left_injective ℂ hv0)
      simpa only [one_smul] using he.symm
    rw [hl,one_smul] at hp
    apply top_unique
    intro x _
    apply W.starProjection_eq_self_iff.mp
    rw [hp]
    rfl

theorem globalWeylAlgebra_vacuum_cyclic (a : Parameters) :
    (GlobalCharge.vacuumOrbitSpan (globalWeylAlgebra a) (fockVacuum a)).topologicalClosure=⊤ := by
  exact GlobalCharge.irreducible_nonzero_vacuum_is_cyclic
    (globalWeylAlgebra a) (globalWeylAlgebra_irreducible a) (fockVacuum a) (by
      rw [← exponentialVector_zero]
      exact exponentialVector_ne_zero a 0)

end AASCKleinGordon
