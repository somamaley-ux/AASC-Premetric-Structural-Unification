def curvatureCoordinateTransport (g : Fin 7) (x : Fin 20 → ℝ) (i : Fin 20) : ℝ :=
  ∑ j : Fin 20, curvatureGeneratorMatrix g i j * x j

def pullbackFour (L : Tensor2) (R : Tensor4) (a b c d : Fin 4) : ℝ :=
  ∑ i : Fin 4, L i a * (∑ j : Fin 4, L j b *
    (∑ k : Fin 4, L k c * (∑ l : Fin 4, L l d * R i j k l)))

theorem pullbackFour_flip (k : Fin 4) (R : Tensor4) (a b c d : Fin 4) :
    pullbackFour (flipComparison k).forward R a b c d =
      (if a = k then -1 else 1) * (if b = k then -1 else 1) *
      (if c = k then -1 else 1) * (if d = k then -1 else 1) * R a b c d := by
  simp [pullbackFour, flipComparison, flipMatrix, Matrix.diagonal_apply, ite_mul]

#print axioms pullbackFour_flip
