def comparisonGenerator (g : Fin 7) : LorentzComparison :=
  match g.val with
  | 0 => flipComparison 0
  | 1 => flipComparison 1
  | 2 => flipComparison 2
  | 3 => flipComparison 3
  | 4 => swap12Comparison
  | 5 => swap13Comparison
  | _ => boostComparison

